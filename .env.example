# At least one API key is required — there is no local/offline agent.
# Copy values from tdd-prototype-lab .env when sharing a machine.

LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3

CURSOR_API_KEY=
CURSOR_MODEL=auto

# Optional named slots (also OpenAI-compatible):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M3
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-6
# KIMI_API_KEY=
# Kimi Code membership (Moderato): https://api.kimi.com/coding/v1
# Moonshot pay-as-you-go (different keys): https://api.moonshot.ai/v1 or https://api.moonshot.cn/v1
# KIMI_BASE_URL=https://api.kimi.com/coding/v1
# KIMI_MODEL=k3-256k
# (alias) MOONSHOT_API_KEY=

PORT=3850
HOST=127.0.0.1
AGENT_PROVIDER=cursor
