# At least one API key is required — there is no local/offline agent.
# Copy values from tdd-prototype-lab .env when sharing a machine.

LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3

CURSOR_API_KEY=
CURSOR_MODEL=auto

# Optional named slots (also OpenAI-compatible):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1
# MINIMAX_API_KEY=
